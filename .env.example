# Copia questo file come .env e inserisci solo le chiavi che abiliti.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Usa gli ID disponibili sul tuo account. Questi sono esempi configurabili.
OPENAI_MODEL=gpt-5.6-luna
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-3-flash-preview
GROQ_MODEL=llama-3.3-70b-versatile

# Il giudice e la scorecard usano questo provider.
JUDGE_PROVIDER=openai
AUDITOR_PROVIDER=groq
ANTHROPIC_THINKING=disabled

# MAX_OUTPUT_TOKENS include anche eventuali token di ragionamento.
MAX_OUTPUT_TOKENS=2500
AGENT_WORD_LIMIT=320
JUDGE_WORD_LIMIT=450

# Per modelli OpenAI compatibili: meno latenza/costo e risposte più concise.
OPENAI_REASONING_EFFORT=low
OPENAI_VERBOSITY=low

RUNS_DIR=runs
