# Copy this file to .env and add only the API keys you intend to use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Use model IDs available on your account. These are configurable examples.
OPENAI_MODEL=gpt-5.6-luna
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-3-flash-preview
GROQ_MODEL=llama-3.3-70b-versatile

# Providers used by the judge and auditor roles.
JUDGE_PROVIDER=openai
AUDITOR_PROVIDER=groq
ANTHROPIC_THINKING=disabled

# MAX_OUTPUT_TOKENS may also include reasoning tokens, depending on the provider.
MAX_OUTPUT_TOKENS=2500
AGENT_WORD_LIMIT=320
JUDGE_WORD_LIMIT=450

# For compatible OpenAI models: lower latency/cost and more concise responses.
OPENAI_REASONING_EFFORT=low
OPENAI_VERBOSITY=low

RUNS_DIR=runs